+    private static final Logger LOGGER = AppConfig.getLogger(Streamer.class);
+    private volatile InputStream urlStream;
+    private long generation;
+    private Thread streamer_thread;
+    private io.mosip.facepad.NativeFrameChallenge frameChallenge;
+    private final javafx.beans.property.ReadOnlyStringWrapper challengePrompt = new javafx.beans.property.ReadOnlyStringWrapper("");
+    public javafx.beans.property.ReadOnlyStringProperty challengePromptProperty() { return challengePrompt.getReadOnlyProperty(); }
+    public synchronized io.mosip.facepad.NativeFrameChallenge getFrameChallenge() { return frameChallenge; }
+    private void publishPrompt(InputStream input, long token, String prompt) {
+        Platform.runLater(() -> {
+            synchronized (Streamer.this) {
+                if (current(input, token)) challengePrompt.set(prompt);
+            }
+        });
+    }
+    public volatile byte[] imageBytes;
+    private static volatile Image streamImage;
+    private static volatile ImageView imageView;
+
+    public synchronized void setUrlStream(InputStream inputStream) {
+        InputStream previous = urlStream;
+        generation++;
+        if (frameChallenge != null) frameChallenge.cancel();
+        frameChallenge = null;
+        urlStream = inputStream;
+        imageBytes = null;
+        streamImage = null;
+        final long resetToken = generation;
+        try {
+            Platform.runLater(() -> {
+                synchronized (Streamer.this) {
+                    if (generation == resetToken && urlStream == null)
+                        challengePrompt.set("Camera stopped. Start it again to verify liveness.");
+                }
+            });
+        } catch (IllegalStateException noToolkit) { /* Parser-only checks have no JavaFX runtime. */ }
+        if (previous != null && previous != inputStream) close(previous);
+    }
+
+    private static void close(InputStream input) {
+        try { input.close(); }
+        catch (IOException e) { LOGGER.error("Failed to close camera stream", e); }
+    }
