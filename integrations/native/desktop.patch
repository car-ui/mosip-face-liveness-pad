+    private static final Logger LOGGER = AppConfig.getLogger(Streamer.class);
+    private volatile InputStream urlStream;
+    private long generation;
+    private Thread streamer_thread;
+    public volatile byte[] imageBytes;
+    private static volatile Image streamImage;
+    private static volatile ImageView imageView;
+
+    public synchronized void setUrlStream(InputStream inputStream) {
+        InputStream previous = urlStream;
+        generation++;
+        urlStream = inputStream;
+        imageBytes = null;
+        streamImage = null;
+        if (previous != null && previous != inputStream) close(previous);
+    }
+
+    private static void close(InputStream input) {
+        try { input.close(); }
+        catch (IOException e) { LOGGER.error("Failed to close camera stream", e); }
+    }
+
+    public InputStream getUrlStream() { return urlStream; }
+    public void setStreamImage(Image image) { streamImage = image; }
+    public Image getStreamImage() { return streamImage; }
+    public byte[] getStreamImageBytes() {
+        byte[] current = imageBytes;
+        return current == null ? null : current.clone();
+    }
+    public static void setImageView(ImageView view) { imageView = view; }
+    public void setStreamImageToImageView() {
+        Image image = streamImage;
+        ImageView view = imageView;
+        if (view != null) Platform.runLater(() -> view.setImage(image));
+    }
+
+    private synchronized boolean current(InputStream input, long token) {
+        return urlStream == input && generation == token;
+    }
+
+    public synchronized void startStream(InputStream inputStream, ImageView preview, ImageView scanImage) {
+        setUrlStream(inputStream);
+        if (inputStream == null) return;
+        final long token = generation;
+        final AtomicBoolean updatePending = new AtomicBoolean();
+        streamer_thread = new Thread(() -> {
+            try {
+                while (current(inputStream, token) && !Thread.currentThread().isInterrupted()) {
+                    byte[] frame = retrieveNextImage(inputStream);
+                    Image image = new Image(new ByteArrayInputStream(frame));
+                    if (image.isError()) throw new IOException("Camera JPEG could not be decoded");
+                    synchronized (Streamer.this) {
+                        if (!current(inputStream, token)) break;
+                        imageBytes = frame;
+                        if (scanImage != null) streamImage = image;
+                    }
+                    // Bound the JavaFX queue when the camera is faster than rendering.
+                    if (preview != null && updatePending.compareAndSet(false, true)) {
+                        Platform.runLater(() -> {
+                            try {
+                                synchronized (Streamer.this) {
+                                    if (current(inputStream, token)) preview.setImage(image);
+                                }
+                            } finally { updatePending.set(false); }
+                        });
+                    }
+                }
+            } catch (IOException | RuntimeException e) {
+                if (current(inputStream, token)) LOGGER.error("Camera stream stopped", e);
+            } finally {
+                synchronized (Streamer.this) {
+                    // An older reader must never close or clear a replacement session.
+                    if (current(inputStream, token)) setUrlStream(null);
+                }
+                close(inputStream);
+            }
+        }, "STREAMER_THREAD");
+        streamer_thread.setDaemon(true);
+        streamer_thread.start();
+    }
+
+    public byte[] retrieveNextImage(InputStream input) throws IOException {
+        return BoundedMjpegReader.readFrame(input);
+    }
+
+    public synchronized void stop() {
+        SessionContext.setAutoLogout(true);
+        setUrlStream(null);
+        if (streamer_thread != null) streamer_thread.interrupt();
+        streamer_thread = null;
+    }
 }
