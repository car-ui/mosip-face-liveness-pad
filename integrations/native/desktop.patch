+    }
+    private synchronized void startStream(InputStream inputStream, ImageView preview, ImageView scanImage, boolean activeRequired, io.mosip.facepad.NativePadPolicy.Workflow workflow) {
+        setUrlStream(inputStream);
+        if (inputStream == null) return;
+        final long token = generation;
+        final AtomicBoolean updatePending = new AtomicBoolean();
+        streamer_thread = new Thread(() -> {
+            try {
+                io.mosip.facepad.NativeFrameChallenge active = null;
+                if (activeRequired) {
+                    publishPrompt(inputStream, token, "Loading liveness models");
+                    active = io.mosip.facepad.DesktopPadCheckpoint.newFrameChallenge(workflow);
+                    synchronized (Streamer.this) {
+                        if (!current(inputStream, token)) { active.cancel(); return; }
+                        frameChallenge = active;
+                    }
+                }
+                String previousPrompt = null;
+                while (current(inputStream, token) && !Thread.currentThread().isInterrupted()) {
+                    byte[] frame = retrieveNextImage(inputStream);
+                    io.mosip.facepad.BoundedImage.requireJpeg(frame);
+                    Image image = new Image(new ByteArrayInputStream(frame));
+                    if (image.isError()) throw new IOException("Camera JPEG could not be decoded");
+                    if (active != null) {
+                        io.mosip.facepad.NativeActiveSession.State state = active.observe(frame);
+                        String prompt = active.prompt();
+                        if (state == io.mosip.facepad.NativeActiveSession.State.COMPLETE)
+                            prompt = "Actions complete. Capturing face...";
+                        if (state == io.mosip.facepad.NativeActiveSession.State.REJECTED)
+                            prompt = "Liveness could not be verified. Restart camera.";
+                        if (state == io.mosip.facepad.NativeActiveSession.State.CONSUMED)
+                            prompt = "Liveness checked. Validating identity.";
+                        if (!prompt.equals(previousPrompt)) { publishPrompt(inputStream, token, prompt); previousPrompt = prompt; }
+                    }
+                    synchronized (Streamer.this) {
+                        if (!current(inputStream, token)) break;
+                        imageBytes = frame;
+                        if (scanImage != null) streamImage = image;
+                    }
+                    // Bound the JavaFX queue when the camera is faster than rendering.
+                    if (preview != null && updatePending.compareAndSet(false, true)) {
+                        Platform.runLater(() -> {
+                            try {
+                                synchronized (Streamer.this) {
+                                    if (current(inputStream, token)) preview.setImage(image);
+                                }
+                            } finally { updatePending.set(false); }
+                        });
+                    }
+                }
+            } catch (Exception | LinkageError e) {
+                if (current(inputStream, token)) {
+                    LOGGER.error("Camera stream stopped", e);
+                    publishPrompt(inputStream, token, "Liveness unavailable. Restart camera.");
+                }
+            } finally {
+                synchronized (Streamer.this) {
+                    // An older reader must never close or clear a replacement session.
+                    if (current(inputStream, token)) setUrlStream(null);
+                }
+                close(inputStream);
+            }
+        }, "STREAMER_THREAD");
+        streamer_thread.setDaemon(true);
+        streamer_thread.start();
+    }
+
+    public byte[] retrieveNextImage(InputStream input) throws IOException {
+        return BoundedMjpegReader.readFrame(input);
+    }
+
+    public synchronized void stop() {
+        SessionContext.setAutoLogout(true);
+        setUrlStream(null);
+        if (streamer_thread != null) streamer_thread.interrupt();
+        streamer_thread = null;
+    }
 }
